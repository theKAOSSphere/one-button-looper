@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<https://github.com/theKAOSSphere/one-button-looper/>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-obl.html> ;
        modgui:stylesheet <modgui/stylesheet-obl.css> ;
        modgui:screenshot <modgui/screenshot-obl.png> ;
        modgui:thumbnail <modgui/thumbnail-obl.png> ;
        modgui:monitoredOutputs [ lv2:symbol "looper_state" ] , [ lv2:symbol "dub_count" ] ;
        modgui:brand "KAOSS" ;
        modgui:label "One-Button Looper" ;
        modgui:model "japanese" ;
        modgui:panel "4-knobs" ;
        modgui:color "red" ;
        modgui:knob "aluminium" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "threshold" ;
            lv2:name "Thresh" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "dry" ;
            lv2:name "Dry Amt." ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "loop_gain" ;
            lv2:name "Loop Gain" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "continuous_dub" ;
            lv2:name "Cont. Dub" ;
        ] ;
    ] .
