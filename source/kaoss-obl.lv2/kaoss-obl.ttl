@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .

<https://github.com/theKAOSSphere/one-button-looper/>
	a lv2:Plugin, lv2:UtilityPlugin;

	doap:name "One-Button Looper";
	doap:license <http://opensource.org/licenses/mit>;

	lv2:microVersion 1 ;
	lv2:minorVersion 0 ;
        
	mod:brand "KAOSS" ;
	mod:label "One-Button Looper" ;

	doap:developer [
        foaf:name "KAOSS";
        foaf:homepage <https://github.com/theKAOSSphere>;
        foaf:mbox <mailto:thekaossphere@gmail.com>;
    ];

    doap:maintainer [
        foaf:name "KAOSS";
        foaf:homepage <https://github.com/theKAOSSphere>;
        foaf:mbox <mailto:thekaossphere@gmail.com>;
    ];

	rdfs:comment  """One-Button Looper is a simple looper plugin with only one button. It mimics the working of the TC Electronic Ditto and the Boss RC-1 looper pedals.
Usage:
• Adjust the "Threshold" to only start recording once playing has started. If set to the lowest value, recording will start immediately. Otherwise it will start recording when the first sound comes in. The threshold can be used to filter out noise.
• Adjust the "Dry Amount" to reduce the volume of the input signal directly routed to the output. Setting it to 0 means you will only hear any looped sounds, no direct sound.
• Press Once: Starts recording the loop.
• Press Again: Ends the recording and starts playback immediately.
• Press Once (during playback): Starts overdubbing. This allows you to layer additional parts over the original loop.
• Press Twice (quickly): Stops playback or recording.
• Press and Hold: Clears the loop when playback is stopped.
• Undo/Redo: While playing or overdubbing, pressing and holding the footswitch undoes the last overdub. Pressing and holding again restores the overdub (redo).
• Adjust the "Loop Gain" knob to control the volume level of the looped audio. Available range from muted to +12dB with halfway position being unity gain.
• Turning the "Continuous Dub" on allows for overdubbing continuously without needing to press the button again.
• "Looper Mode" switch to toggle between Digital and Vintage looper modes. Vintage mode adds a bit of warmth and character to the looped audio. Labelled as "Vintage" on the MODGUI.
• "Undo Mode" toggles between "Undo/Redo" and "Infinite Undo" modes. In "Undo/Redo" mode, pressing and holding the button once will undo the last overdub, and pressing and holding again will redo it. In "Infinite Undo" mode, you can keep pressing and holding the button to step back through all your overdubs one by one.
	""";
	
	lv2:port [
		a lv2:AudioPort, lv2:InputPort;
		lv2:index 0;
		lv2:symbol "in1";
		lv2:name "In1";
	] , [
		a lv2:AudioPort, lv2:InputPort;
		lv2:index 1;
		lv2:symbol "in2";
		lv2:name "In2";
	] , [
		a lv2:AudioPort, lv2:OutputPort;
		lv2:index 2;
		lv2:symbol "out1";
		lv2:name "Out1";
	] ,	[
		a lv2:AudioPort, lv2:OutputPort;
		lv2:index 3;
		lv2:symbol "out2";
		lv2:name "Out2";
	] ,	[
		a lv2:InputPort, lv2:ControlPort;
		lv2:index 4;
		lv2:symbol "threshold";
		lv2:name "Threshold";
		lv2:default -70.0;
		lv2:minimum -90.0;
		lv2:maximum 24.0;
		units:unit units:db;
	] , [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 5;
		lv2:symbol "main_button";
		lv2:name "Main Button";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
	] , [
		a lv2:InputPort, lv2:ControlPort;
		lv2:index 6;
		lv2:symbol "dry";
		lv2:name "Dry Amount";
		lv2:default 1.0;
		lv2:minimum 0.0;
		lv2:maximum 1.0;
	] , [
		a lv2:ControlPort, lv2:InputPort;
		lv2:index 7;
		lv2:symbol "continuous_dub";
		lv2:name "Continuous Dub";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:integer, lv2:toggled;
	] , [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 8;
		lv2:symbol "looper_state";
		lv2:name "Looper State";
		lv2:minimum 0;
		lv2:maximum 5;
		lv2:portProperty lv2:integer;
		rdfs:comment "0=Empty, 1=Waiting, 2=Recording, 3=Stopped, 4=Playing, 5=Overdubbing";
	] , [
		a lv2:ControlPort, lv2:OutputPort;
		lv2:index 9;
		lv2:symbol "dub_count";
		lv2:name "Dub Count";
		lv2:minimum 0;
		lv2:maximum 128;
		lv2:portProperty lv2:integer;
		rdfs:comment "Number of recorded dub layers";
	] ,	[
		a lv2:InputPort, lv2:ControlPort;
		lv2:index 10;
		lv2:symbol "loop_gain";
		lv2:name "Loop Gain";
		lv2:default 0.5;
        lv2:minimum 0.0;
        lv2:maximum 1.0;
        lv2:scalePoint [ rdfs:label "-inf";  rdf:value 0.0 ];
        lv2:scalePoint [ rdfs:label "-45dB"; rdf:value 0.25 ];
        lv2:scalePoint [ rdfs:label "0dB";   rdf:value 0.5 ];
        lv2:scalePoint [ rdfs:label "+6dB";  rdf:value 0.75 ];
        lv2:scalePoint [ rdfs:label "+12dB"; rdf:value 1.0 ];
	] , [
		a lv2:InputPort, lv2:ControlPort;
		lv2:index 11;
		lv2:symbol "looper_mode";
		lv2:name "Looper Mode";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:integer, lv2:enumeration;
    	lv2:scalePoint [ rdfs:label "Digital"; rdf:value 0 ];
    	lv2:scalePoint [ rdfs:label "Vintage"; rdf:value 1 ];
	] , [
		a lv2:InputPort, lv2:ControlPort;
		lv2:index 12;
		lv2:symbol "undo_mode";
		lv2:name "Undo Mode";
		lv2:default 0;
		lv2:minimum 0;
		lv2:maximum 1;
		lv2:portProperty lv2:integer, lv2:enumeration;
    	lv2:scalePoint [ rdfs:label "Undo/Redo"; rdf:value 0 ];
    	lv2:scalePoint [ rdfs:label "Infinite Undo"; rdf:value 1 ];
	] .
